# URL của backend FastAPI. Copy file này thành .env rồi chỉnh nếu cần.
VITE_API_URL=
# ----------###--------------#
# PHÍA DƯỚI ĐÂY XÓA ĐI CŨNG ĐƯỢC:
## CÁCH CHẠY BACKEND FASTAPI
#1. MỞ TERMINAL
# cd backend
# python -m venv venv
# source venv/Scripts/activate
# pip install -r requirements.txt
# python create_admin.py --username admin --password "MatKhau123" ( đặt mât khẩu admin TÙY THÍCH )
# uvicorn app.main:app --reload --port 8000

#2. MỞ TIẾP 1 TERMINAL KHÁC ĐỂ CHYAJ FRONTEND VITE
# CÁCH CHẠY FRONTEND VITE
# cd frontend
# npm install
# npm run dev
### lƯU Ý: MySQL phải chạy trước khi chạy backend FastAPI, nếu không sẽ báo lỗi kết nối MySQL.